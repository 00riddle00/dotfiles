[Desktop Entry]
Name=Mattermost
Comment=Mattermost Desktop
Exec=mattermost-desktop %u
Icon=mattermost-desktop
Terminal=false
Type=Application
Categories=Network;InstantMessaging;
MimeType=x-scheme-handler/mattermost;
StartupNotify=true
StartupWMClass=Mattermost
