# vim: set ft=desktop noai nu et ts=2 sw=2:
#------------------------------------------------------------------------------
# Author: 00riddle00 (Tomas Giedraitis)
# Date:   2026-08-11 00:56:57 CEST
# Path:   ~/.local/share/applications/text.desktop
# URL:    https://github.com/00riddle00/dotfiles
#------------------------------------------------------------------------------
[Desktop Entry]
Type=Application
Name=EDITOR
GenericName=Text Editor
Exec=bash -c 'kitty --hold tmux new-session "${EDITOR}" "${@}"' _ %F
Terminal=false
Comment=Launches ${EDITOR} in terminal
