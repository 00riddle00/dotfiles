#*
# Open the clipboard notes file in Neovim inside a dedicated kitty window
# (class: clipboard).
#**
kitty \
  --class clipboard \
  --override remember_window_size=no \
  --override initial_window_width=135c \
  --override initial_window_height=61c \
  --hold \
  tmux new-session "${EDITOR}" -c \
  "e ${NOTES}/coding/clipboard.md | :cd %:p:h"

sleep 0.05

# shellcheck disable=SC2034
for i in {1..3}; do
  i3-msg '[instance="clipboard"] move left' > /dev/null 2>&1
done
