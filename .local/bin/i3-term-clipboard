#*
# Open the clipboard notes file in Neovim inside a dedicated kitty window
# (class: clipboard).
#**
kitty \
  --class clipboard \
  --override initial_window_columns=135 \
  --override initial_window_lines=61 \
  --hold \
  tmux new-session "${EDITOR}" -c \
  "e ${NOTES}/coding/clipboard.md | :cd %:p:h"

sleep 0.05

# shellcheck disable=SC2034
for i in {1..3}; do
  i3-msg "[instance=\"clipboard\"] move left" > /dev/null 2>&1
done
