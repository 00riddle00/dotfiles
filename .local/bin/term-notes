#!/usr/bin/env bash
# vim: set ft=bash tw=88 nu ai et ts=2 sw=2:
#------------------------------------------------------------------------------
# Author: 00riddle00 (Tomas Giedraitis)
# Date:   2026-08-08 23:35:38 CEST
# Path:   ~/.local/bin/term-notes
# URL:    https://github.com/00riddle00/dotfiles
#------------------------------------------------------------------------------
#*
# Open the notes file in Neovim in a new Kitty terminal window.
#**

#* USAGE:
#*   ${0}
#**
kitty \
  --class notes \
  --override remember_window_size=no \
  --override initial_window_width=135c \
  --override initial_window_height=61c \
  --hold \
  tmux new-session "${EDITOR}" -c \
  "e ${NOTES}/coding/main.md | :cd %:p:h | :cd .."
