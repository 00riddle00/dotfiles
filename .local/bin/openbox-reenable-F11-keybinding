#!/usr/bin/env bash
# vim: set ft=bash tw=88 nu ai et ts=2 sw=2:
#------------------------------------------------------------------------------
# Author: 00riddle00 (Tomas Giedraitis)
# Date:   2026-08-08 23:34:31 CEST
# Path:   ~/.local/bin/openbox-reenable-F11-keybinding
# URL:    https://github.com/00riddle00/dotfiles
#------------------------------------------------------------------------------
#*
# Disable the F11 keybinding in Openbox, since it's very useful in spreadsheet
# programs and other applications. The script wraps the F11 keybinding's XML
# block with <!-- and -->, effectively commenting it out.
#
# CAUTION: Enabling the already enabled keybinding will break the Openbox XML
#**

#* USAGE:
#*   ${0}
#**
nvim -e \
  -c 'g/<keybind key="F11">/.-1d' \
  -c 'g/<keybind key="F11">/.+5d' \
  -c 'wq' \
  "${XDG_CONFIG_HOME}/openbox/rc.xml"

openbox --reconfigure
