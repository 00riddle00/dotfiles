#*
# Open the timer/stopwatch in a new Urxvt terminal window.
#**

#* USAGE:
#*   ${0}
#**
kitty \
  --class timer \
  --override initial_window_columns=105 \
  --override initial_window_lines=40 \
  --hold \
    tmux new-session "termdown -B | lolcat"
