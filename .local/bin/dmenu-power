#!/usr/bin/env bash
# vim: set ft=bash tw=88 nu ai et ts=2 sw=2:
#------------------------------------------------------------------------------
# Author: 00riddle00 (Tomas Giedraitis)
# Date:   2024-09-27 13:24:20 EEST
# Path:   ~/.local/bin/dmenu-power
# URL:    https://github.com/00riddle00/dotfiles
#------------------------------------------------------------------------------
#*
# Log out, reboot or shutdown using dmenu.
#**

#* USAGE:
#*   ${0}
#**
[[ -z "${DISPLAY}" ]] && exit 1

choice="$( \
  echo -e "0:  Logout\n1:  Reboot\n2:  Shutdown" \
    | dmenu -i \
    | cut -d ':' -f 1
)"

[[ -z "${choice}" ]] && exit 1

# Gracefully close all open apps.
while read -r app; do
  wmctrl -i -c "${app}"
done < <(wmctrl -l | awk '{print $1}')

# Execute the choice in background.
case "${choice}" in
  0) kill "$(pgrep X)" & ;;
  1) shutdown -r now & ;;
  2) shutdown -h now & ;;
esac
