#*
# Focus a program window in Sway by title (default) or class (-c).
#**

# USAGE:
#   ${0} WINDOW_NAME       # fuzzy match on window title
#   ${0} WINDOW_CLASS -c   # fuzzy match on window class
# e.g.:
#   ${0} "- Thunar"
#   ${0} org.pwmt.zathura.Zathura -c

win="${1}"

if [[ -z "${win}" ]]; then
  echo "Usage: ${0} WINDOW_NAME [-c]"
  exit 1
fi

if [[ "${2}" == "-c" ]]; then
  # Match on WM_CLASS (Wayland apps set app_id; Xwayland apps set class)
  swaymsg "[app_id=\"${win}\"] focus" || swaymsg "[class=\"${win}\"] focus" || swaymsg "[title=\"${win}\"] focus"
else
  # Match on window title (case-insensitive substring)
  #swaymsg "[title=\"(?i)${win}\"] focus"
  swaymsg "[app_id=\"${win}\"] focus"
fi
