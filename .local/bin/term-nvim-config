#!/usr/bin/env bash
# vim: set ft=bash tw=79 nu ai et ts=2 sw=2:
#------------------------------------------------------------------------------
# Author: 00riddle00 (Tomas Giedraitis)
# Date:   2026-08-07 23:50:05 CEST
# Path:   ~/.local/bin/term-nvim-config
# URL:    https://github.com/00riddle00/dotfiles
#------------------------------------------------------------------------------
#*
# Open the Neovim config dir with Neovim in a new Kitty terminal window.
#**

#* USAGE:
#*   ${0}
#**
kitty \
  --class nvim-config \
  --override initial_window_columns=105 \
  --override initial_window_lines=40 \
  --hold \
    tmux new-session "${EDITOR}" -c \
      "e ${XDG_CONFIG_HOME}/nvim | :cd %:p:h"
