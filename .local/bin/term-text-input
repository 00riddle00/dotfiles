#!/usr/bin/env bash
# vim: set ft=bash tw=79 nu ai et ts=2 sw=2:
#------------------------------------------------------------------------------
# Author: 00riddle00 (Tomas Giedraitis)
# Date:   2026-08-07 23:50:07 CEST
# Path:   ~/.local/bin/term-text-input
# URL:    https://github.com/00riddle00/dotfiles
#------------------------------------------------------------------------------
#*
# Open a temporary Markdown file in Neovim in a new Kitty terminal window.
# This is useful for quick writing with the help of GitHub Copilot.
#**

#* USAGE:
#*   ${0}
#**
tmpfile="/tmp/temp_$(date +%F_%H_%M_%S).md"
printf '<!-- vim: set ft=markdown tw=88 nu ai et ts=2 sw=2: -->\n\n\n' > "$tmpfile"

kitty \
  --class text-input \
  --override initial_window_columns=105 \
  --override initial_window_lines=40 \
  --hold \
    tmux new-session "${EDITOR}" -c "3" "$tmpfile"
