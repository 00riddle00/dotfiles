# URL:    https://github.com/00riddle00/dotfiles
#------------------------------------------------------------------------------
#*
# Set up the U43-only monitor layout using xrandr for the computer with
# hostname "panther".
#**

#* USAGE:
#*   ${0}
#**

# Check if X is running.
if xset q &> /dev/null; then
  # If external monitor is connected, use it.
  if xrandr | awk '/ connected/{print $1}' | rg -q -- "${DP2_SCREEN}"; then
    xrandr \
      --output "${DP2_SCREEN}" --auto --rotate normal \
      --output "${LAPTOP_SCREEN}" --off
  else
    xrandr --output "${LAPTOP_SCREEN}" --auto
  fi
fi
