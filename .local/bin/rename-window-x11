#------------------------------------------------------------------------------
#*
# Rename the active X11 window by prompting for a new name via zenity.
#**

#**
#* USAGE:
#*   ${0}
#**
win=$(xdotool getactivewindow)
name=$(zenity --entry --title="Rename Window" --text="Window name:")
xdotool set_window --name "$name" "$win"
