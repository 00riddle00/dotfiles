#!/usr/bin/env bash
# vim: set ft=bash tw=88 nu ai et ts=2 sw=2:
#------------------------------------------------------------------------------
# Author: 00riddle00 (Tomas Giedraitis)
# Date:   2026-08-08 23:34:24 CEST
# Path:   ~/.local/bin/i3-term-notes
# URL:    https://github.com/00riddle00/dotfiles
#------------------------------------------------------------------------------
#*
# Open the notes file in Neovim in a new Kitty terminal window, and move it a
# few times to the left, in i3 window manager. Preferably, this window (with
# the instance name "notes") should be placed on the 1st (i.e. leftmost)
# workspace in i3 config.
#**

#* USAGE:
#*   ${0}
#**
kitty \
  --class notes \
  --override remember_window_size=no \
  --override initial_window_width=135c \
  --override initial_window_height=61c \
  --hold \
  tmux new-session "${EDITOR}" -c \
  "e ${NOTES}/coding/main.md | :cd %:p:h | :cd .."

sleep 0.05

# shellcheck disable=SC2034
for i in {1..3}; do
  i3-msg "[instance=\"notes\"] move left" > /dev/null 2>&1
done
