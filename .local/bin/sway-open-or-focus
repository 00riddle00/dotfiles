#!/usr/bin/env bash
#
# Focus a Sway window by its app_id (Wayland) or WM_CLASS (Xwayland),
# or launch the program if no matching window exists.
#
# USAGE:
#   sway-open-or-focus PROGRAM [IDENTIFIER]
#
#   PROGRAM       – the command you’d run (e.g. thunar, keepassxc, kitty)
#   IDENTIFIER    – optional; the app_id or WM_CLASS to match
#                   (defaults to PROGRAM)
#
# Example:
#   sway-open-or-focus keepassxc org.keepassxc.KeePassXC
#   sway-open-or-focus thunar      # matches app_id "thunar"
#

prog="${1}"
ident="${2:-${1}}"

if [[ -z "${prog}" ]]; then
  echo "Usage: ${0} PROGRAM [IDENTIFIER]" >&2
  exit 1
fi

# Try to focus a native Wayland window first:
if swaymsg "[app_id=\"${ident}\"]" focus 2>/dev/null; then
    echo "HERE"
  exit 0
fi

# Fallback to Xwayland WM_CLASS:
if swaymsg "[class=\"${ident}\"]" focus 2>/dev/null; then
    echo "HERE2"
  exit 0
fi

# 3) Fallback to instance
if swaymsg "[instance=\"${ident}\"] focus" 2>/dev/null; then
  exit 0
fi

# Nothing matched – launch the program:
setsid "${prog}" >/dev/null 2>&1 &
exit 0
