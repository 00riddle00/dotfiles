#!/usr/bin/env bash
# vim: set ft=bash tw=88 nu ai et ts=2 sw=2:
#------------------------------------------------------------------------------
# Author: 00riddle00 (Tomas Giedraitis)
# Date:   2026-08-08 23:33:36 CEST
# Path:   ~/.local/bin/copy-latest-screenshot
# URL:    https://github.com/00riddle00/dotfiles
#------------------------------------------------------------------------------
#*
# Copy the latest screenshot from ${HOME}/Screenshots to clipboard.
#*
#* Screenshots are expected to be named like:
#*   2026-05-13_23-13.png
#*
#* USAGE:
#*   ${0}
#**

set -euo pipefail

dir="${HOME}/Screenshots"

latest="$(
  fd -d 1 -t f -e png . "${dir}" \
    | sort \
    | tail -n 1
)"

if [[ -z "${latest}" ]]; then
  echo "No screenshots found in ${dir}" >&2
  exit 1
fi

if command -v wl-copy &> /dev/null && [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
  wl-copy --type image/png < "${latest}"
elif command -v xclip &> /dev/null && [[ -n "${DISPLAY:-}" ]]; then
  xclip -selection clipboard -target image/png -i "${latest}"
elif command -v xsel &> /dev/null && [[ -n "${DISPLAY:-}" ]]; then
  xsel --clipboard --input < "${latest}"
else
  echo "No clipboard tool found: install wl-clipboard, xclip, or xsel" >&2
  exit 1
fi

echo "Copied latest screenshot:"
echo "${latest}"
