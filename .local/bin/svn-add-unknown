#*
# Identify new (unversioned) files in a Subversion working directory and
# automatically add them to version control.
#**

#* USAGE:
#*   ${0}
#*
#* The script needs to be run in a Subversion working directory.
#**
svn status \
  | rg '^?' \
  | sed 's/^\? *//' \
  | awk '{printf "%s@\0", $0}' \
  | xargs -0 --no-run-if-empty \
    svn add ${1+"${@}"}
