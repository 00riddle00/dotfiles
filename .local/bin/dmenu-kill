# URL:    https://github.com/00riddle00/dotfiles
#------------------------------------------------------------------------------
#*
# Kill process using dmenu.
#**

#* USAGE:
#*   ${0}
#**
pid="$(
  ps -a -u "${USER}" -o pid,comm \
    | dmenu -i -l 20 -p "Type to search and select process to kill" \
    | awk '{print $1" "$4}'
)"

if [[ -n ${pid} ]]; then
  choice="$(
    echo -e "Yes\nNo" \
      | dmenu -i -l 20 -p "${pid} will be killed, are you sure?"
  )"

  if [[ ${choice} == "Yes" ]]; then
    kill -9 "${pid}"
  fi
fi
