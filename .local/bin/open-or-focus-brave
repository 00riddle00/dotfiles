#*
# Focus a Brave window by name, or open a new window with that name, if it
# doesn't exist.
#**

#* USAGE:
#*   ${0} WINDOW_NAME
#**
if wmctrl -lx | rg -q "brave-browser\.Brave-browser.*${1}$"; then
  wmctrl -F -a "${1}"
else
  brave --window-name="${1}"
fi
