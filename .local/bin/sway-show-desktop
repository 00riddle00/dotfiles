#!/usr/bin/env bash
# vim: set ft=bash tw=88 nu ai et ts=2 sw=2:
#------------------------------------------------------------------------------
# Author: 00riddle00 (Tomas Giedraitis)
# Date:   2026-08-06 22:02:12 CEST
# Path:   ~/.local/bin/sway-show-desktop
# URL:    https://github.com/00riddle00/dotfiles
#------------------------------------------------------------------------------
#
# Imitate the "Show Desktop" behavior in Sway:
# Switch to DESKTOP_WORKSPACE if you’re on something else,
# otherwise toggle back to the previous workspace.
#
# USAGE:
#   sway-show-desktop DESKTOP_WORKSPACE
#

desktop_wspace="${1}"

if [[ -z ${desktop_wspace} ]]; then
  echo "Usage: ${0} DESKTOP_WORKSPACE" >&2
  exit 1
fi

# grab the currently focused workspace name
current_wspace=$(swaymsg -t get_workspaces \
  | jq -r '.[] | select(.focused).name')

if [[ ${current_wspace} == "${desktop_wspace}" ]]; then
  # already on "desktop" → go back and forth
  swaymsg workspace back_and_forth
else
  # not on "desktop" → switch there
  swaymsg workspace "${desktop_wspace}" output DP-1
fi

# remember which workspace is your "desktop" (optional)
echo "${desktop_wspace}" > /tmp/sway-show-desktop
