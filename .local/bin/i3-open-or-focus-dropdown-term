#!/usr/bin/env bash
# vim:ft=bash:tw=79:sw=2:ts=2:sts=2:et
#------------------------------------------------------------------------------
# Author: 00riddle00 (Tomas Giedraitis)
# Date:   2026-08-08 00:25:35 CEST
# Path:   ~/.local/bin/i3-open-or-focus-dropdown-term
# URL:    https://github.com/00riddle00/dotfiles
#------------------------------------------------------------------------------
#*
# Open or focus kitty dropdown terminal (i.e. scratchpad) in i3 window manager
# by the specified window class name.
#**

#* USAGE:
#*   ${0} WINDOW_CLASS
#**
win_class="${1}"

{
  if ! xdotool search --classname "${win_class}" &> /dev/null; then
    i3-msg "exec --no-startup-id kitty --class ${win_class}"
    sleep 0.05
    i3-msg "[instance=\"${win_class}\"] scratchpad show"
  else
    i3-msg "[instance=\"${win_class}\"] scratchpad show"
  fi
} > /dev/null 2>&1
