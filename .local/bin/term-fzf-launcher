# URL:    https://github.com/00riddle00/dotfiles
#------------------------------------------------------------------------------
#*
# Open the fzf-launcher (for launching programs) in a new Kitty terminal
# window.
#**

#* USAGE:
#*   ${0}
#**
kitty \
  --class fzf-launcher \
  --override initial_window_columns=70 \
  --override initial_window_lines=30 \
    sh -c "fzf-launcher"
