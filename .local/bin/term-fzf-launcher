#!/usr/bin/env bash
# vim: set ft=bash tw=88 nu ai et ts=2 sw=2:
#------------------------------------------------------------------------------
# Author: 00riddle00 (Tomas Giedraitis)
# Date:   2026-08-07 23:58:44 CEST
# Path:   ~/.local/bin/term-fzf-launcher
# URL:    https://github.com/00riddle00/dotfiles
#------------------------------------------------------------------------------
#*
# Open the fzf-launcher (for launching programs) in a new Kitty terminal
# window.
#**

#* USAGE:
#*   ${0}
#**
kitty \
  --class fzf-launcher \
  --override remember_window_size=no \
  --override initial_window_width=70c \
  --override initial_window_height=30c \
    sh -c "fzf-launcher"
