#!/usr/bin/env bash
# vim: set ft=bash tw=88 nu ai et ts=2 sw=2:
#------------------------------------------------------------------------------
# Author: 00riddle00 (Tomas Giedraitis)
# Date:   2026-08-07 18:17:13 CEST
# Path:   ~/.local/bin/ssh-key-doc
# URL:    https://github.com/00riddle00/dotfiles
#------------------------------------------------------------------------------
#*
# Generate a documentation template for an SSH key.
# Fills in everything derivable from the key files; leaves placeholders
# for anything only you know (origin machine, where it's registered, etc).
#**

#* USAGE:
#*   ${0} SSH-PRIVATE-KEY
#* e.g.:
#*   ${0} ~/.ssh/id_cern_ed25519
#*   ${0} ~/.ssh/id_cern_ed25519 > cern_ssh_key_info.txt
#**
set -euo pipefail

RAW_INPUT="${1:?Usage: ${0} <path-to-private-key>}"
# Expand ~ if passed literally, then resolve to an absolute path so this
# works whether you pass a relative name (e.g. run from inside ~/.ssh),
# a ~-prefixed path, or a full path.
RAW_INPUT="${RAW_INPUT/#\~/${HOME}}"
KEY_PATH="$(realpath -m "${RAW_INPUT}")"
PUB_PATH="${KEY_PATH}.pub"

if [[ ! -f "${KEY_PATH}" ]]; then
  echo "Error: private key not found at ${KEY_PATH}" >&2
  exit 1
fi
if [[ ! -f "${PUB_PATH}" ]]; then
  echo "Error: public key not found at ${PUB_PATH}" >&2
  exit 1
fi

# Collapse ${HOME} back to ~ purely for display in the doc.
KEY_PATH_DISPLAY="${KEY_PATH/#${HOME}/\~}"

SHA256_LINE=$(ssh-keygen -lf "${PUB_PATH}")
MD5_LINE=$(ssh-keygen -E md5 -lf "${PUB_PATH}")

BITS=$(awk '{print $1}' <<< "${SHA256_LINE}")
SHA256_FP=$(awk '{print $2}' <<< "${SHA256_LINE}")
MD5_FP=$(awk '{print $2}' <<< "${MD5_LINE}")
ALGO=$(sed -E 's/.*\(([A-Za-z0-9]+)\)$/\1/' <<< "${SHA256_LINE}")
COMMENT=$(
  sed -E 's/^[0-9]+ [A-Za-z0-9]+:[^ ]+ (.*) \([A-Za-z0-9]+\)$/\1/' \
    <<< "${SHA256_LINE}"
)

CREATED=$(stat -c '%y' "${KEY_PATH}" | cut -d'.' -f1)
PUB_KEY_CONTENT=$(cat "${PUB_PATH}")
KEY_BASENAME=$(basename "${KEY_PATH}")

SCRIPT_PATH=$(realpath "${0}")
SCRIPT_PATH_DISPLAY="${SCRIPT_PATH/#${HOME}/\~}"
GEN_DATE=$(date +%Y-%m-%d)
SEP=$(printf -- '-%.0s' $(seq 1 79))

echo "${SEP}"
echo "This info was generated by the script ${SCRIPT_PATH_DISPLAY}"
echo "on ${GEN_DATE}, and then modified manually."
echo "${SEP}"

cat << EOF
Fingerprint:
${BITS} ${SHA256_FP}
${BITS} ${MD5_FP}

Comment: ${COMMENT}
Algorithm: ${ALGO}

Origin machine: <FILL IN>
Created: ${CREATED%% *} (mtime — cross-check if you remember the actual date)
Expires: <FILL IN — check each service below; the key file itself never expires>

Added to:
  * <FILL IN — host/service> (<FILL IN — date>) (Title: <FILL IN — KeePassXC entry title>) — expires <FILL IN, e.g. ~2026-10-01, or Never>
    (if an expiry is set, don't forget a reminder a few weeks ahead — TickTick/Calendar/etc.)

Public key:
${PUB_KEY_CONTENT}

Path: ${KEY_PATH_DISPLAY}

Attachments (expected filenames):
  * ${KEY_BASENAME}
  * ${KEY_BASENAME}.pub
EOF
echo "${SEP}"
