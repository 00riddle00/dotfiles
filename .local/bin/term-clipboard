#!/usr/bin/env bash
# vim: set ft=bash tw=79 nu ai et ts=2 sw=2:
#------------------------------------------------------------------------------
# Author: 00riddle00 (Tomas Giedraitis)
# Date:   2026-08-07 17:28:37 CEST
# Path:   ~/.local/bin/term-clipboard
# URL:    https://github.com/00riddle00/dotfiles
#------------------------------------------------------------------------------
#*
# Open the clipboard file in Neovim in a new Urxvt terminal window.
#**

#* USAGE:
#*   ${0}
#**
kitty \
  --class clipboard \
  --override initial_window_columns=135 \
  --override initial_window_lines=61 \
  --hold \
    tmux new-session "${EDITOR}" -c \
      "e ${NOTES}/coding/clipboard.md | :cd %:p:h"
