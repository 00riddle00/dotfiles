#!/usr/bin/env bash
# vim: set ft=bash tw=88 nu ai et ts=2 sw=2:
#------------------------------------------------------------------------------
# Author: 00riddle00 (Tomas Giedraitis)
# Date:   2026-08-07 00:27:12 CEST
# Path:   ~/.local/bin/set-dark-gtk-theme
# URL:    https://github.com/00riddle00/dotfiles
#------------------------------------------------------------------------------
#*
# Change gtk-theme-name from "Adwaita" to "Adwaita-dark" in:
#   ~/.config/gtk-3.0/settings.ini
# Usage:
#   ${0}
#**

CONFIG="${XDG_CONFIG_HOME}/gtk-3.0/settings.ini"

# In-place replacement using sed -E:
sed -E -i '
  s/^gtk-theme-name=Adwaita$/gtk-theme-name=Adwaita-dark/
' "${CONFIG}"
