#!/usr/bin/env bash
# vim: set ft=bash tw=88 nu ai et ts=2 sw=2:
#------------------------------------------------------------------------------
# Author: 00riddle00 (Tomas Giedraitis)
# Date:   2026-08-07 18:17:07 CEST
# Path:   ~/.local/bin/gpg-key-doc
# URL:    https://github.com/00riddle00/dotfiles
#------------------------------------------------------------------------------
#*
# Generate a documentation template for a GPG key from an exported PUBLIC key
# file (.asc). Uses `gpg --import-options show-only` to inspect the file
# without importing it into your keyring — so this works equally for keys
# already in ~/.gnupg and for keys that only live in Thunderbird's internal
# store (export the public key from Thunderbird first, then point this script
# at that file).
#**

#* USAGE:
#*   ${0} GPG-PUBLIC-KEY
#* e.g.:
#*   ${0} path/to/pubkey.asc
#*   ${0} path/to/pubkey.asc > email_gpg_key_info.txt
#**
set -euo pipefail

PUB_PATH="${1:?Usage: ${0} <path-to-exported-public-key.asc>}"
PUB_PATH="${PUB_PATH/#\~/${HOME}}"

if [[ ! -f ${PUB_PATH} ]]; then
  echo "Error: file not found at ${PUB_PATH}" >&2
  exit 1
fi

RAW=$(gpg --with-colons --import-options show-only --import "${PUB_PATH}" 2> /dev/null)

algo_name() {
  case "${1}" in
    1 | 2 | 3) echo "RSA" ;;
    16) echo "Elgamal" ;;
    17) echo "DSA" ;;
    18) echo "ECDH" ;;
    19) echo "ECDSA" ;;
    22) echo "EdDSA" ;;
    *) echo "Algo#${1}" ;;
  esac
}

usage_name() {
  local u="${1}" out=""
  [[ ${u} == *s* ]] && out+="Sign, "
  [[ ${u} == *c* ]] && out+="Certify, "
  [[ ${u} == *e* ]] && out+="Encrypt, "
  [[ ${u} == *a* ]] && out+="Authenticate, "
  echo "${out%, }"
}

curve_name() {
  case "${1}" in
    ed25519 | cv25519) echo "Curve25519" ;;
    ed448 | cv448) echo "Curve448" ;;
    nistp256) echo "NIST P-256" ;;
    nistp384) echo "NIST P-384" ;;
    nistp521) echo "NIST P-521" ;;
    brainpoolP256r1) echo "Brainpool P-256r1" ;;
    brainpoolP384r1) echo "Brainpool P-384r1" ;;
    brainpoolP512r1) echo "Brainpool P-512r1" ;;
    secp256k1) echo "secp256k1" ;;
    *) echo "${1}" ;;
  esac
}

fmt_fpr() {
  sed -E 's/(.{4})/\1 /g' <<< "${1}" | sed 's/ $//'
}

fmt_date() {
  if [[ -z ${1} || ${1} == "0" ]]; then
    echo "Never"
  else
    date -d "@${1}" +%Y-%m-%d
  fi
}

# Append ${2} to array named ${1}, only if not already present.
add_unique() {
  local -n arr="${1}"
  local val="${2}"
  [[ -z ${val} ]] && return
  local existing
  for existing in "${arr[@]}"; do
    [[ ${existing} == "${val}" ]] && return
  done
  arr+=("${val}")
}

join_by() {
  local sep="${1}"
  shift
  local out="" first=1 item
  for item in "${@}"; do
    if ((first)); then
      out="${item}"
      first=0
    else
      out="${out}${sep}${item}"
    fi
  done
  echo "${out}"
}

# Collect ALL UID lines — a key can have more than one address attached.
mapfile -t UID_LINES < <(grep '^uid:' <<< "${RAW}" | awk -F: '{print $10}')

PRIMARY=$(grep '^pub:' <<< "${RAW}")
PRIMARY_FPR=$(grep '^fpr:' <<< "${RAW}" | head -1 | awk -F: '{print $10}')
P_ALGO_NUM=$(awk -F: '{print $4}' <<< "${PRIMARY}")
P_ALGO=$(algo_name "${P_ALGO_NUM}")
P_BITS=$(awk -F: '{print $3}' <<< "${PRIMARY}")
P_KEYID=$(awk -F: '{print $5}' <<< "${PRIMARY}")
P_CREATED=$(fmt_date "$(awk -F: '{print $6}' <<< "${PRIMARY}")")
P_EXPIRES=$(fmt_date "$(awk -F: '{print $7}' <<< "${PRIMARY}")")
# shellcheck disable=SC2018
P_USAGE_RAW=$(awk -F: '{print $12}' <<< "${PRIMARY}" | tr -cd 'a-z')
P_USAGE=$(usage_name "${P_USAGE_RAW}")
P_CURVE_RAW=$(awk -F: '{print $17}' <<< "${PRIMARY}")

# Collect all subkey lines up front so we know the total count before
# deciding whether to number them, and so we can build the Key type summary.
mapfile -t SUB_LINES < <(grep '^sub:' <<< "${RAW}")
SUB_COUNT=${#SUB_LINES[@]}

# Build the "Key type" summary across primary + all subkeys.
ALGO_LIST=()
CURVE_LIST=()
IS_ECC=0
add_unique ALGO_LIST "${P_ALGO}"
case "${P_ALGO_NUM}" in 18 | 19 | 22) IS_ECC=1 ;; esac
[[ -n ${P_CURVE_RAW} ]] && add_unique CURVE_LIST "$(curve_name "${P_CURVE_RAW}")"

for line in "${SUB_LINES[@]}"; do
  s_algo_num=$(awk -F: '{print $4}' <<< "${line}")
  add_unique ALGO_LIST "$(algo_name "${s_algo_num}")"
  case "${s_algo_num}" in 18 | 19 | 22) IS_ECC=1 ;; esac
  s_curve_raw=$(awk -F: '{print $17}' <<< "${line}")
  [[ -n ${s_curve_raw} ]] && add_unique CURVE_LIST "$(curve_name "${s_curve_raw}")"
done

if ((IS_ECC)); then
  KEY_TYPE_LINE="Key type: ECC ($(join_by " / " "${ALGO_LIST[@]}"), \
$(join_by ", " "${CURVE_LIST[@]}"))"
else
  KEY_TYPE_LINE="Key type: $(join_by " / " "${ALGO_LIST[@]}")"
fi

SCRIPT_PATH=$(realpath "${0}")
SCRIPT_PATH_DISPLAY="${SCRIPT_PATH/#${HOME}/\~}"
GEN_DATE=$(date +%Y-%m-%d)
SEP=$(printf -- '-%.0s' $(seq 1 79))

echo "${SEP}"
echo "This info was generated by the script ${SCRIPT_PATH_DISPLAY}"
echo "on ${GEN_DATE}, and then modified manually."
echo "${SEP}"
echo "GPG Key ID: 0x${P_KEYID}"
echo "Fingerprint: $(fmt_fpr "${PRIMARY_FPR}")"
echo
echo "Purpose: <FILL IN>"
echo
for u in "${UID_LINES[@]}"; do
  echo "UID: ${u}"
done
echo "${KEY_TYPE_LINE}"
echo
echo "Structure:"
echo "  * Primary key — ${P_USAGE} — ID 0x${P_KEYID} — ${P_ALGO}, ${P_BITS}-bit"

for i in "${!SUB_LINES[@]}"; do
  line="${SUB_LINES[${i}]}"
  S_ALGO=$(algo_name "$(awk -F: '{print $4}' <<< "${line}")")
  S_BITS=$(awk -F: '{print $3}' <<< "${line}")
  S_KEYID=$(awk -F: '{print $5}' <<< "${line}")
  # shellcheck disable=SC2018
  S_USAGE_RAW=$(awk -F: '{print $12}' <<< "${line}" | tr -cd 'a-z')
  S_USAGE=$(usage_name "${S_USAGE_RAW}")
  if ((SUB_COUNT > 1)); then
    LABEL="Subkey $((i + 1))"
  else
    LABEL="Subkey"
  fi
  echo "  * ${LABEL} — ${S_USAGE} — ID 0x${S_KEYID} — ${S_ALGO}, ${S_BITS}-bit"
done

cat << EOF

Created: ${P_CREATED}
Expires: ${P_EXPIRES}

Present on:
  * <FILL IN — which machines currently hold the secret key>

Public key locations:
  * <FILL IN — e.g. Keybase, keys.openpgp.org, WKD>

Attachments (expected filenames):
  * ${PRIMARY_FPR}_private.key
  * ${PRIMARY_FPR}_pubkey.asc
  * ${PRIMARY_FPR}_revoke.asc  (if generated)
EOF
echo "${SEP}"
