#!/usr/bin/env bash
# vim: set ft=bash tw=88 nu ai et ts=2 sw=2:
#------------------------------------------------------------------------------
# Author: 00riddle00 (Tomas Giedraitis)
# Date:   2026-08-08 00:18:56 CEST
# Path:   ~/.local/bin/sway-open-or-focus-dropdown-term
# URL:    https://github.com/00riddle00/dotfiles
#------------------------------------------------------------------------------
#*
# Open or focus Kitty dropdown terminal (i.e. scratchpad) in i3 window manager
# by the specified window class name.
#**

#* USAGE:
#*   ${0} WINDOW_CLASS
#**
win_class="${1}"

{
  if ! xdotool search --classname "${win_class}" &> /dev/null; then
    swaymsg "exec kitty --class ${win_class}"
    sleep 0.05
    swaymsg "[instance=\"${win_class}\"] scratchpad show"
  else
    swaymsg "[instance=\"${win_class}\"] scratchpad show"
  fi
} > /dev/null 2>&1
