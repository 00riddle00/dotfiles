# Path:   ~/.local/bin/term-cmus
# URL:    https://github.com/00riddle00/dotfiles
#------------------------------------------------------------------------------
#*
# Open the C* Music Player in a new Kitty terminal window.
#**

#* USAGE:
#*   ${0}
#**
kitty \
  --class cmus \
  --override remember_window_size=no \
  --override initial_window_width=105c \
  --override initial_window_height=40c \
    tmux new-session "cmus"
