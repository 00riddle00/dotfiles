#*
# Open the C* Music Player in a new Kitty terminal window.
#**

#* USAGE:
#*   ${0}
#**
kitty \
  --class cmus \
  --override initial_window_columns=105 \
  --override initial_window_lines=40 \
    tmux new-session "cmus"
