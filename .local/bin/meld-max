#*
# Run Meld with explicit scaling overrides for UHD/4K environments.
# This wrapper is intended for terminal use and fully forwards any arguments.
#**

#* USAGE:
#*   ${0} [MELD_ARGUMENTS...]
#*
#* EXAMPLES:
#*   ${0} file1 file2
#*   ${0} --diff fileA fileB
#**
GDK_SCALE=2 GDK_DPI_SCALE=1 exec meld "${@}"
