" vim: set ft=tridactyl tw=88 nu ai et ts=2 sw=2:
"------------------------------------------------------------------------------
" Author: 00riddle00 (Tomas Giedraitis)
# Date:   2026-09-12 04:14:20 CEST
# Path:   ~/.config/tridactyl/tridactylrc
" URL:    https://github.com/00riddle00/dotfiles
"------------------------------------------------------------------------------

" ============================================================================
" General
" ============================================================================

" Config file format version
set configversion 2.0

" Use Neovim as the external editor for text areas and form inputs
set editorcmd nvim

" ============================================================================
" UI
" ============================================================================

" Colours
colours dark

" Show the current mode and pressed keys in the status indicator
set modeindicatorshowkeys true

" Better hint visibility: home-row keys used for link hint labels when selecting
" elements on a page
set hintchars asdfghjkl

" ============================================================================
" Commands
" ============================================================================

" Easier reload config
command retry source ~/.config/tridactyl/tridactylrc

" ============================================================================
" Keybindings
" ============================================================================

" -------------------------------------
" Unbind default keybindings
" -------------------------------------

" Prevent accidental tab close
unbind d

" Restore native Ctrl+A / Ctrl+X behavior
unbind <C-a>
unbind <C-x>

" I barely use these even in Vim
" <C-f> - use default Firefox search
unbind <C-f>
unbind <C-b>
unbind <C-e>
unbind <C-y>

" -------------------------------------
" Tab navigation
" -------------------------------------

bind --mode=browser <A-h> tabprev
bind --mode=browser <A-l> tabnext
bind --mode=browser <A-ArrowLeft> tabprev
bind --mode=browser <A-ArrowRight> tabnext

" -------------------------------------
" Tab search
" -------------------------------------

bind --mode=browser <C-,> fillcmdline tab
bind --mode=browser <C-.> fillcmdline tab
bind --mode=browser <AC-,> open about:firefoxview#recentlyclosed
bind --mode=browser <AC-.> open about:firefoxview#recentlyclosed

" -------------------------------------
" Tab management
" -------------------------------------

bind --mode=browser <A-s> pin
bind --mode=browser <A-w> tabonly
bind --mode=browser <C-1> tabdetach

" -------------------------------------
" Tab movement
" -------------------------------------

bind --mode=browser <AC-h> tabmove -1
bind --mode=browser <AC-l> tabmove +1
bind --mode=browser <AC-ArrowLeft> tabmove -1
bind --mode=browser <AC-ArrowRight> tabmove +1

" -------------------------------------
" Tab groups
" -------------------------------------

command groupcurrent jsb browser.tabs.query({active:true,currentWindow:true}).then(([tab])=>browser.tabs.group({tabIds:tab.id}))
command groupall jsb browser.tabs.query({currentWindow:true,pinned:false}).then(tabs=>tabs.length&&browser.tabs.group({tabIds:tabs.map(tab=>tab.id)}))
command ungroupcurrentgroup jsb browser.tabs.query({active:true,currentWindow:true}).then(([tab])=>tab.groupId===-1?null:browser.tabs.query({currentWindow:true,groupId:tab.groupId}).then(tabs=>browser.tabs.ungroup(tabs.map(tab=>tab.id))))

bind --mode=browser <C-3> groupcurrent
bind --mode=browser <C-g> groupall
bind --mode=browser <AC-g> ungroupcurrentgroup

" -------------------------------------
" Misc
" -------------------------------------

bind --mode=browser <AC-s> open about:preferences
