# GIMP shortcutsrc
#
# If this file is deleted, all shortcuts will be reset to defaults.

(file-version 1)

( action "tools-swap"                 "x"                        )
( action "filters-levels"             "<Primary>l"               )
( action "edit-paste"                 "<Primary>v" "Paste"       )
( action "dialogs-toolbox"                                       )
( action "tools-crop"                 "c"                        )
( action "dialogs-gradients"                                     )
( action "view-zoom-fit-in"           "<Primary>0"               )
( action "tools-gradient"                                        )
( action "dialogs-layers"                                        )
( action "layers-new"                 "equal"                    )
( action "tools-scale"                "<Primary>t"               )
( action "image-resize"               "<Primary><Alt>c"          )
( action "script-fu-round-corners"    "<Primary><Alt>r"          )
( action "tools-free-select"          "l"                        )
( action "layers-duplicate"           "<Alt>d"                   )
( action "tools-warp"                                            )
( action "view-show-rulers"           "<Primary><Shift>r"        )
( action "tools-fuzzy-select"         "w"                        )
( action "image-scale"                "<Primary><Alt>i"          )
( action "image-duplicate"                                       )
( action "context-colors-default"     "<Primary>b"               )
( action "view-zoom-in"               "<Primary>plus" "ZoomIn"   )
( action "dialogs-keyboard-shortcuts" "<Primary><Alt>s"          )
( action "dialogs-action-search"      "<Primary><Alt>p"          )
( action "image-merge-layers"                                    )
( action "tools-move"                 "v"                        )
( action "tools-path"                 "b"                        )
( action "tools-paintbrush"           "d"                        )
( action "file-print-gtk"             "<Primary>p"               )
( action "select-none"                "<Primary>d"               )
( action "view-show-selection"                                   )
( action "tools-rotate"               "<Primary>r"               )
( action "layers-merge-down"          "<Primary><Alt>m"          )
( action "layers-delete"              "minus"                    )
( action "tools-color-picker"         "i"                        )
( action "view-zoom-out"              "<Primary>minus" "ZoomOut" )
( action "filters-curves"             "<Primary>m"               )
( action "tools-pencil"               "p"                        )
( action "file-open-recent-10"                                   )
( action "filters-hue-saturation"     "<Primary>u"               )
( action "tools-clone"                                           )
( action "tools-iscissors"                                       )
( action "tools-bucket-fill"          "g"                        )
( action "view-shrink-wrap"                                      )
( action "tools-convolve"             "b"                        )
