#!/usr/bin/env bash
# vim:tw=79:sw=2:ts=2:sts=2:et
#------------------------------------------------------------------------------
# Author: 00riddle00 (Tomas Giedraitis)
# Date:   2026-08-06 21:57:18 CEST
# Path:   ~/.config/X11/xinitrc
# URL:    https://github.com/00riddle00/dotfiles
#------------------------------------------------------------------------------

# Load X resources
[[ -f ~/.config/X11/Xresources ]] && xrdb ~/.config/X11/Xresources

# Configure multiple monitors
if [[ "$(hostname)" == "panther" ]]; then
  # set-up-monitors-panther
  # set-up-monitors-panther-laptop-u27_dp-u27_hdmi_port
  xrandr \
    --output eDP-1  --pos 0x1480 \
    --output DP-2   --primary --pos 1920x400 \
    --output HDMI-1 --rotate right --pos 5760x0
elif [[ "$(hostname)" == "tulkun" ]]; then
  # set-up-monitors-tulkun
  xrandr \
    --output HDMI-0 --mode 2560x1440 --rotate right --pos 0x0 \
    --output DP-0   --mode 3840x2160 --primary --rotate normal --pos 1440x400 \
    --output DP-2   --mode 2560x1440 --rotate left --pos 5280x0
fi

# Disable touchpad on a ThinkPad
if [[ "$(hostname)" == "panther" ]]; then
  xinput disable "SYNA8005:00 06CB:CD8C Touchpad"
fi

# Launch applications
(
  sleep 1
  obsidian &
  keepassxc &
  ente &
) &
xscreensaver -no-splash &
desktop-wakatime &
dropbox &
flameshot &
dunst &
copyq &

# Disabled: replaced by systemd --user ssh-agent.service (SSH_AUTH_SOCK
# exported in .zprofile). Having both spawn agents caused SSH_AUTH_SOCK
# to point at whichever one won the race, breaking KeePassXC's agent link.
#eval "$(ssh-agent -s)"

# See Arch Wiki: https://wiki.archlinux.org/title/Xinit#xinitrc
#   Note: At the very least, ensure that the last if block in
#   /etc/X11/xinit/xinitrc is present in your ~/.xinitrc file to ensure that
#   the scripts in /etc/X11/xinit/xinitrc.d are sourced.
xinitdir="/etc/X11/xinit"

if [ -d "$xinitdir"/xinitrc.d ]; then
  for f in "$xinitdir/xinitrc.d"/?*.sh; do
    # shellcheck disable=SC1090
    [ -x "$f" ] && . "$f"
  done
  unset f
fi

# Reapply keyboard layout after X input devices finish initializing.
(
  sleep 2
  set-keyboard-layout
) &

# Start xremap after the X session (after the X session is initialized) so
# application-specific remaps can connect to the X server.
xremap --watch \
  "${XDG_CONFIG_HOME}/xremap/config.yml" \
  > "${XDG_RUNTIME_DIR}/xremap.log" 2>&1 &

# Window manager
#exec i3
exec openbox-session
