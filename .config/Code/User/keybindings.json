[
  /* ---------------------
   * Enabled actions
   * ---------------------
   */
  // Alt + {}
  {
    "key": "alt+f1",
    "command": "editor.action.commentLine",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "alt+f7",
    "command": "workbench.action.compareEditor.nextChange",
    "when": "textCompareEditorVisible"
  },
  {
    "key": "alt+f7",
    "command": "workbench.action.editor.nextChange",
    "when": "editorTextFocus && !textCompareEditorActive"
  },
  {
    "key": "alt+0",
    "command": "workbench.action.lastEditorInGroup"
  },
  {
    "key": "alt+1",
    "command": "workbench.action.toggleSidebarVisibility",
    "when": "sideBarVisible && activeViewlet == 'workbench.view.explorer' && sideBarFocus"
  },
  {
    "key": "alt+1",
    "command": "workbench.view.explorer",
    "when": "!sideBarVisible || activeViewlet != 'workbench.view.explorer' || !sideBarFocus"
  },
  {
    "key": "alt+2",
    "command": "workbench.action.focusActiveEditorGroup"
  },
  {
    "key": "alt+3",
    "command": "workbench.action.togglePanel"
  },
  {
    "key": "alt+4",
    "command": "workbench.action.terminal.toggleTerminal"
  },
  {
    "key": "alt+`",
    "command": "workbench.action.toggleSidebarVisibility"
  },
  {
    "key": "alt+r",
    "command": "editor.action.startFindReplaceAction"
  },
  {
    "key": "alt+v",
    "command": "editor.action.clipboardPasteAction",
    "when": "textInputFocus && !terminalFocus"
  },
  {
    "key": "alt+v",
    "command": "filesExplorer.paste",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "alt+v",
    "command": "workbench.action.terminal.paste",
    "when": "terminalFocus && (terminalHasBeenCreated || terminalProcessSupported)"
  },
  {
    "key": "alt+v",
    "command": "markdown.extension.editing.paste",
    "when": "editorHasSelection && editorTextFocus && editorLangId =~ /^markdown$|^rmd$|^quarto$/"
  },
  // Ctrl + {}
  {
    "key": "ctrl+tab",
    "command": "workbench.action.nextEditor"
  },
  {
    "key": "ctrl+'",
    "command": "workbench.action.showCommands"
  },
  {
    "key": "ctrl+'",
