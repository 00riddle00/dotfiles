# URL:    https://github.com/00riddle00/dotfiles
#------------------------------------------------------------------------------
# VS Code allows to have comments in this file.
*/

{
  /* --- Editor --- */
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.fontFamily": "'JetBrainsMono Nerd Font', monospace",
  "editor.fontSize": 16,
  "editor.fontLigatures": true,
  "editor.lineNumbers": "relative",
  "editor.rulers": [88, 120],
  "editor.renderLineHighlight": "none",
  "editor.minimap.enabled": false,
  "editor.mouseWheelZoom": true,

  "editor.linkedEditing": true,
  "editor.inlineSuggest.enabled": true,

  "editor.selectionHighlight": false,
  "editor.occurrencesHighlight": "off", /* <-- Can be very useful sometimes */
  "editor.matchBrackets": "near",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.guides.bracketPairsHorizontal": false,
  "editor.guides.highlightActiveBracketPair": true,

  "editor.unicodeHighlight.allowedCharacters": {
    "–": true
  },

  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "keyword.other.dotenv",
        "settings": {
          "foreground": "#FF000000"
        }
      }
    ]
  },

  /* --- Workbench & Appearance --- */
  "workbench.colorTheme": "One Dark Pro Mix",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.startupEditor": "none",
  "workbench.editor.empty.hint": "hidden",
  "workbench.secondarySideBar.defaultVisibility": "hidden",

  "workbench.colorCustomizations": {
    "statusBar.background": "#004e62",
    "statusBar.foreground": "#9ccae6"
  },

  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "*.sqlite": "default"
  },

  /* --- Window --- */
  "window.titleBarStyle": "custom",
  "window.menuBarVisibility": "toggle",
  "window.customMenuBarAltFocus": false,
  "window.openFoldersInNewWindow": "on",

  /* --- Files & Explorer --- */
  "files.autoSave": "afterDelay",

  "files.associations": {
    "*.dbclient-js": "javascript",
    "**/templates/**/*.html": "jinja-html",
    "*.jinja": "jinja-html",
    "*.jinja2": "jinja-html",
    "*.j2": "jinja-html",
    ".env*": "dotenv"
  },

  "files.exclude": {
    "**/__pycache__": true
  },

  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,

  /* --- Terminal --- */
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.mouseWheelZoom": true,
  "terminal.integrated.enableMultiLinePasteWarning": "never",

  /* --- Git & Source Control --- */
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.suggestSmartCommit": false,
  "diffEditor.ignoreTrimWhitespace": false,

  /* --- VSCode-Neovim --- */
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },

  "vscode-neovim.ctrlKeysForNormalMode": ["d", "i", "o", "r", "u", "v"],
  "vscode-neovim.ctrlKeysForInsertMode": ["d", "i", "o", "r", "u"],

  /* --- AI --- */
  "github.copilot.enable": {
    "*": true,
    "plaintext": true,
    "markdown": false,
    "scminput": false
  },

  "github.copilot.nextEditSuggestions.enabled": true,
  "chat.mcp.gallery.enabled": true,
  "claudeCode.preferredLocation": "panel",

  /* --- Language-Specific --- */
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnPaste": false
  },

  "[sql]": {
    "editor.defaultFormatter": "sqlfluff.vscode-sqlfluff"
  },

  "[shellscript]": {
    "editor.defaultFormatter": "mkhl.shfmt"
  },

  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  "[jinja-html]": {
    "editor.defaultFormatter": null
  },

  /* --- Extension-Specific --- */
  "cSpell.enabledFileTypes": {
    "jinja-html": true
  },

  "database-client.autoSync": true,
  "jupyter.askForKernelRestart": false,
  "makefile.configureOnOpen": true,

  "shellcheck.executablePath": "shellcheck",

  "shfmt.executableArgs": [
    "-ln=bash",
    "-s",
    "-i",
    "2",
    "-bn",
    "-ci",
    "-sr"
  ],

  "sqlfluff.linter.run": "onType",
  "sqlfluff.format.enabled": true,

  "yaml.disableSchemaDetection": [
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml"
  ],

  /* --- Security, Privacy & Updates --- */
  "telemetry.telemetryLevel": "off",

  "security.workspace.trust.untrustedFiles": "open",
  "security.workspace.trust.banner": "never",

  "update.showReleaseNotes": false,

  /* --- Misc / Technical --- */
  "keyboard.dispatch": "keyCode",

  /* --- New and unsorted --- */
}
