[General]
# ...
# ...
savePath=/home/riddle/Screenshots
showDesktopNotification=false
uiColor=#0061c0
userColors=picker, #ffffff, #000000, #f7035f, #ff9500, #ffd60a, #34c759, #27aeb9, #02ccfe, #bebebe
# Due to a problem with xdg-desktop-portal, the workaround for flameshot v14:
useX11LegacyScreenshot=true
captureActiveMonitor=true

[Shortcuts]
TYPE_ACCEPT=Ctrl+s
TYPE_CIRCLE=e
TYPE_CIRCLECOUNT=n
TYPE_DRAWER=l
TYPE_MOVESELECTION=v
TYPE_PIXELATE=f
TYPE_TOGGLE_PANEL=Alt+1
