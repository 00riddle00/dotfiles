[GUI]
ApplicationTheme=dark
CompactMode=false
HideMenubar=true
HidePreviewPanel=true
HideUsernames=true
MinimizeToTray=true
ShowTrayIcon=true
TrayIconAppearance=monochrome-dark

[PasswordGenerator]
Length=25
Logograms=true
SpecialChars=true

[Security]
ClearClipboardTimeout=20
LockDatabaseIdleSeconds=10800
