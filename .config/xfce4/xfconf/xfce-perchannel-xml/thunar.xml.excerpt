* Thunar settings
-->

<?xml version="1.1" encoding="UTF-8"?>

<channel name="thunar" version="1.0">
  <property name="last-view" type="string" value="ThunarCompactView"/>
  <!-- ... -->
  <property name="last-side-pane" type="string" value="THUNAR_SIDEPANE_TYPE_SHORTCUTS"/>
  <property name="last-show-hidden" type="bool" value="false"/>
  <!-- ... -->
  <property name="last-compact-view-zoom-level" type="string" value="THUNAR_ZOOM_LEVEL_25_PERCENT"/>
  <property name="last-menubar-visible" type="bool" value="false"/>
  <!-- ... -->
  <property name="last-statusbar-visible" type="bool" value="true"/>
  <property name="misc-symbolic-icons-in-toolbar" type="bool" value="true"/>
  <property name="misc-single-click" type="bool" value="false"/>
  <property name="misc-highlighting-enabled" type="bool" value="true"/>
</channel>
