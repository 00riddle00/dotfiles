# ================================================
#  Definitions
# ================================================

# 'exec' command in this config file, e.g.:
#   exec kitty --class dropdown_math -e R -q
# To run the same command from a terminal (but not inside Tmux):
#   swaymsg 'exec kitty --class dropdown_math -e R -q'
# For Tmux, use the alias 'swaymsg-tmux' instead of 'swaymsg'
#   (see ${ZDOTDIR}/aliases.zsh).
#
# `exec_always` – runs the command every time the config is reloaded,
# including on Sway startup.

set $mod Mod4
set $alt Mod1

# Drag floating windows by holding down $mod and left mouse button.
# Resize them with right mouse button+$mod.
# Despite the name, also works for non-floating windows.
# Change normal to inverse to use left mouse button for resizing and right
# mouse button for dragging.
floating_modifier $alt normal

set $gap_size_top   0
set $gap_size_inner 8
set $gap_size_outer 4

set $col_bg_seacolor       #073542
set $col_swaybar_bg        #002b36
set $col_arch_blue         #1793d1
set $col_light_blue        #79bac1
set $col_pretty_blue       #268bd2
set $col_pretty_light_blue #00afd7

set $wspace1  "1:  "
set $wspace2  "2:  "
set $wspace3  "3:  "
set $wspace4  "4:  "
set $wspace5  "5:  "
set $wspace6  "6:  "
set $wspace7  "7: 󰇮 "
set $wspace8  "8:  "
set $wspace9  "9: ♫ "
set $wspace10 "10:  "

# ================================================
#  Startup
# ================================================

# To automatically unlock KWallet protected by the login password,
# in addition to configuring PAM.
exec /usr/lib/pam_kwallet_init

# This amazing script uses the python-i3ipc library to switch the layout
# between horizontal and vertical splits depending on the currently focused
# window dimensions.
exec autotiling

# Open notes
#exec sway-term-notes

# This will lock the screen after 300 seconds of inactivity, then turn off
# the displays after another 300 seconds, and turn the screens back on when
# resumed. It will also lock the screen before the computer goes to sleep.
exec swayidle -w \
    timeout 300 'swaylock -f -c 000000' \
    timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f -c 000000'

exec dropbox start

exec mako

# ================================================
# Output
# ================================================

# Monitors

output HDMI-A-1 resolution 2560x1440@60hz transform 90 position 0 0
output DP-1 resolution 3840x2160@60hz transform normal position 1440 0
output DP-2 resolution 2560x1440@60hz transform 270 position 5280 0

# For gaming:
output HDMI-A-1 disable
output DP-1 resolution 3840x2160@60hz transform normal position 1440 0
output DP-2 disable

# Background color
output * background $col_bg_seacolor solid_color

# ================================================
# Input
# ================================================

# Keyboard layouts: US and Lithuanian, toggle with Alt+Shift, Caps Lock as Escape
input * {
    xkb_layout us,lt
    xkb_options grp:alt_shift_toggle,caps:escape
}

# Disable touchpad on a ThinkPad
input "SYNA8005:00 06CB:CD8C Touchpad" {
    events disabled
}

# ================================================
#  Workspaces
# ================================================

# Assign workspaces 1,4,7 to the left monitor:
workspace $wspace1 output HDMI-A-1
workspace $wspace4 output HDMI-A-1
workspace $wspace7 output HDMI-A-1

# Assign workspace 2,5,8,10 to the middle monitor:
workspace $wspace2  output DP-1
workspace $wspace5  output DP-1
workspace $wspace8  output DP-1
workspace $wspace10 output DP-1

# Assign workspace 3,6,9 to the right monitor:
workspace $wspace3 output DP-2
workspace $wspace6 output DP-2
workspace $wspace9 output DP-2

# ================================================
#  Appearance
# ================================================

# Gaps
#gaps top   $gap_size_top
#gaps outer $gap_size_outer
#gaps inner $gap_size_inner
# Smart gaps turn off gaps if only one
# container on the workspace is present
smart_gaps on
#smart_gaps off

# Window borders
#for_window [class="^.*"] border pixel 1

default_border none
default_floating_border none
titlebar_border_thickness 0

smart_borders on
#smart_borders off

 # Status bar
bar {
  font                    pango:Source Code Pro Bold 12
  status_command          i3blocks
  position                top
  tray_padding            5
  # Hide tray icons:
  #tray_output             none
  bindsym button4         nop
  bindsym button5         nop
  workspace_buttons       yes
  strip_workspace_numbers no

  colors {
    separator  $col_pretty_blue
    background $col_swaybar_bg
    statusline $col_pretty_blue

    #                  Border          Background      Text
    focused_workspace  $col_swaybar_bg $col_swaybar_bg $col_pretty_light_blue
    active_workspace   $col_swaybar_bg $col_swaybar_bg $col_arch_blue
    inactive_workspace $col_swaybar_bg $col_swaybar_bg $col_light_blue
    urgent_workspace   $col_arch_blue  $col_arch_blue  $col_swaybar_bg
    binding_mode       #b71c1c         #b71c1c         #000000
  }
}

# Colors
# Class                 Border         Background             Text             Indicator
client.focused          $col_arch_blue $col_pretty_light_blue $col_light_blue  $col_arch_blue
client.focused_inactive $col_arch_blue $col_arch_blue         $col_light_blue  $col_arch_blue
client.unfocused        $col_arch_blue $col_arch_blue         $col_light_blue  $col_arch_blue
client.urgent           $col_arch_blue $col_arch_blue         $col_light_blue  $col_arch_blue
client.placeholder      $col_arch_blue $col_arch_blue         $col_light_blue  $col_arch_blue

