# ================================================
#  Keybindings
# ================================================

# ----------------------------
#  Escape, Return, Space keys
# ----------------------------

bindsym $mod+Return      exec     kitty
bindsym $alt+w       floating toggle
bindsym $alt+Tab         kill

# ----------------------------
#  Letter keys
# ----------------------------

bindsym $alt+c         exec sway-open-or-focus obsidian
bindsym $alt+e         exec GTK_THEME=Adwaita-dark thunar
bindsym $alt+p         exec pavucontrol
bindsym $mod+b         exec sway-open-or-focus gimp-3.0
bindsym $mod+c         exec sway-open-or-focus code
#bindsym $mod+e         exec sway-focus "thunar"
bindsym $mod+g         exec sway-open-or-focus smartsvn SmartSVN
bindsym $mod+i         exec kitty -e htop
bindsym $mod+m         exec sway-open-or-focus nomacs org.nomacs.ImageLounge
bindsym $mod+o         exec sway-open-or-focus keepassxc org.keepassxc.KeePassXC
bindsym $mod+p         exec sway-open-or-focus pycharm jetbrains-pycharm
