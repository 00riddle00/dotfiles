{
    "initial_working_directory": "~",
    "pdf_previewer": "system",
    "editor_keybindings": "vim",
    "jobs_tab_visibility": "shown",
    "rainbow_parentheses": true,
    "relative_line_numbers": true,
    "strip_trailing_whitespace": true,
    "soft_wrap_r_files": true,
    "show_diagnostics_r": false,
    "code_completion": "manual",
    "rainbow_fenced_divs": false,
    "console_double_click_select": true,
    "posix_terminal_shell": "bash",
    "editor_theme": "Tokyo Night",
    "enable_mousewheel_zoom": true,
    "fold_style": "begin-only",
    "toolbar_visible": false,
    "source_with_echo": true,
    "copilot_enabled": true,
    "auto_save_on_blur": true,
    "auto_save_on_idle": "commit"
}
